# KNTO kernel version
CONFIG_LOCALVERSION="-関東機関"
CONFIG_LOCALVERSION_AUTO=n

# Change CPU default Frequency
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=n
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# IPA3 and QCACLD
CONFIG_QCA_CLD_WLAN=m
CONFIG_GSI=y
CONFIG_GSI_REGISTER_VERSION_2=y
CONFIG_IPA_CLIENTS_MANAGER=y
CONFIG_IPA_WDI_UNIFIED_API=y
CONFIG_RMNET_IPA3=y
CONFIG_RNDIS_IPA=y
CONFIG_IPA3_REGDUMP=y
CONFIG_IPA3_APPS_REGDUMP=y
CONFIG_IPA3_REGDUMP_IPA_4_5=y
CONFIG_IPA3_4_5_RGSTR=n
